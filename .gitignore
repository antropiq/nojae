# Workspace policy / stores (hidden folder, read-write-policy.json governs it)
.nojae/

# Secrets. The hub declaration files and the e2e connection fixture have a
# committed .example template; the store below has none.
# ``.env``/``.env.test`` stay ignored although the app no longer reads either
# (its own configuration is boot flags now): an install that predates the change
# may still hold its old file, with whatever it held in it, and a gitignore that
# dropped the name would expose that to ``git add .``.
.env
.env.test
# nojaé's own settings store: binary and single-writer, so it is never
# hand-edited and has no committed template -- the app creates and owns it.
nojae.db
nojae.db-wal
nojae.db-shm

# E2E fixture workspaces (created and removed by web/e2e)
e2e-workspace/
e2e-ws-root/
e2e-two-tabs-a/
e2e-two-tabs-b/

# Logs
logs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
build/
.coverage
htmlcov/

# Editor
.vscode/

# OS
.DS_Store

# Others
.playwright-mcp
