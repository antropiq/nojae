# Workspace policy / stores (hidden folder, read-write-policy.json governs it)
.nojae/

# Secrets (each text secret file has a committed .example template)
.env
.env.test
# nojaé's own settings store: binary and single-writer, so it is never
# hand-edited and has no committed template -- the app creates and owns it.
nojae.db
nojae.db-wal
nojae.db-shm

# E2E fixture workspaces (created and removed by web/e2e)
e2e-workspace/
e2e-ws-root/
e2e-two-tabs-a/
e2e-two-tabs-b/

# Logs
logs/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
*.egg-info/
build/
.coverage
htmlcov/

# Editor
.vscode/

# OS
.DS_Store

# Others
.playwright-mcp
