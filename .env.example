# Copy to .env at the project root and adjust for your platform.
# Real environment variables take precedence over the values defined here.

# LLM_DEBUG=1 makes the in-house LLM client log the payload of every request
# (URL, model, body) to the server console at DEBUG, so a failed call can be
# read off that console. The refused call's status and upstream body reach the
# UI's error line whether or not this is on; what the flag adds is the payload.
# Very verbose; switch it back off once the failure is diagnosed.
#LLM_DEBUG=1

# MCP connectors (Chat tab only) are declared only in
# .nojae/mcp-settings.json at the working location: seeded from
# mcp_connectors/mcp-settings.default.json when a folder becomes the
# working location, their per-entry ``enable`` flag is the single
# source of truth, no .env key is involved.
# The model connection — servers, their models, the key, the system
# prompt, sampling and the vision flag — and the tool-loop cap (one
# number per agent) live in nojae's settings store at the install
# root, edited from the Settings dialog. It is a database, not a file
# to hand-edit, and no .env key is involved.

# Absolute path to the python interpreter the stdio connectors run on (the
# console and fedit commands in .nojae/mcp-settings.json expand
# ${NOJAE_PYTHON_ROOT} from it as their first argument).
#NOJAE_PYTHON_ROOT=

# How many times a refused model round is asked again before the failure is
# final (default 3). 0 switches the waiting off, so a refused round fails on
# its first attempt as it did before.
#NETWORK_FAIL_MAX_RETRY=3

# Seconds to wait between two attempts at the same round (default 10). 0 asks
# again at once, spending the same budget with no pause.
#NETWORK_FAIL_WAIT_FOR=10
